YOUTUBE_CLIENT_ID=tu_client_id_aqui
YOUTUBE_CLIENT_SECRET=tu_client_secret_aqui
YOUTUBE_REFRESH_TOKEN=tu_token_aqui
TTS_API_KEY=tu_api_key_aqui
DEFAULT_LANGUAGE=es-MX

# Render (HG): perfil por defecto y cache persistente de LaTeX/clips Manim
# VA_QUALITY=fast            # fast | low-res | production
# VA_THREADS=2
# VA_CACHE_DIR: NO la pongas aquí. docker-compose.yml ya la fija para el contenedor
# (/app/data/.cache) y MoviePy carga este .env también fuera de Docker: en
# Windows esa ruta rompía dvisvgm. Sin variable, la caché va a ~/.cache/video_automation.

# Límites del contenedor (docker-compose.yml). Ver docs/docker-recursos.md
# VA_CPUS=2                  # núcleos para el contenedor
# VA_MEM_LIMIT=3g            # 3g = 1 render de producción; 4g = 2 en paralelo; 1g basta para --draft
