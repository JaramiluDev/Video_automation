YOUTUBE_CLIENT_ID=tu_client_id_aqui
YOUTUBE_CLIENT_SECRET=tu_client_secret_aqui
YOUTUBE_REFRESH_TOKEN=tu_token_aqui
TTS_API_KEY=tu_api_key_aqui
DEFAULT_LANGUAGE=es-MX

# Google Sheets ingestion
GOOGLE_SHEETS_DOCUMENT_ID=tu_sheet_id_aqui
GOOGLE_SHEETS_SHEET_NAME=Hoja1
GOOGLE_SHEETS_OUTPUT_FILENAME=guion_importado.mp4
GOOGLE_SHEETS_CREDENTIALS_FILE=./secrets/google-service-account.json
# Alternativa segura para Docker/CI si prefieres inyectar el JSON completo:
# GOOGLE_SHEETS_CREDENTIALS_JSON={"type":"service_account",...}

# Fallback local si la red o la API fallan
LOCAL_FALLBACK_SCRIPT=examples/sample_script.yaml
